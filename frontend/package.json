    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.0.0"
  }
